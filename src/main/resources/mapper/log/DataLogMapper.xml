<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gobb.repair.domain.log.mapper.DataLogMapper">

    <insert id="insert" parameterType="com.gobb.repair.domain.log.entity.DataLog">
        INSERT INTO CM_DATA_LOG (
            REGIST_DATE,
            REGIST_IP,
            USE_BIT,
            TABLE_NAME,
            FK_SERIAL,
            STATE_TYPE,
            USER_ID,
            SUMMARY
        ) VALUES (
                     NOW(),
                     #{registIp},
                     'Y',
                     #{tableName},
                     #{fkSerial},
                     #{stateType},
                     #{userId},
                     #{summary}
                 )
    </insert>

</mapper>